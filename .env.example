# MediaFlow Baseline v1 - Environment Variables Configuration Template (Spec 21)

# Application Environment
NODE_ENV=development
LOG_LEVEL=info
MEDIAFLOW_DEMO_MODE=true

# Database Connection (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mediaflow

# Cache & Queue Connection (Redis)
REDIS_URL=redis://localhost:6379

# Object Storage Connection (MinIO / S3 API Compatible)
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SOURCE_BUCKET=mediaflow-source
MINIO_PROCESSED_BUCKET=mediaflow-processed
MINIO_DELIVERY_BUCKET=mediaflow-delivery

# Security & CORS Origins
SESSION_SECRET=super-secret-key-change-in-production-min-32-chars
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000

# File Upload & Media Limits
UPLOAD_PART_SIZE_BYTES=16777216
MAX_UPLOAD_SIZE_BYTES=5368709120
MAX_VIDEO_DURATION_SECONDS=7200

# Worker Concurrency & Transcode Limits
MEDIA_WORKER_CONCURRENCY=2
FFMPEG_TIMEOUT_SECONDS=10800
