{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@mediaflow/contracts": ["packages/contracts/src/index.ts"],
      "@mediaflow/database": ["packages/database/src/index.ts"],
      "@mediaflow/domain": ["packages/domain/src/index.ts"],
      "@mediaflow/application": ["packages/application/src/index.ts"],
      "@mediaflow/object-storage": ["packages/object-storage/src/index.ts"],
      "@mediaflow/queue": ["packages/queue/src/index.ts"],
      "@mediaflow/media": ["packages/media/src/index.ts"],
      "@mediaflow/observability": ["packages/observability/src/index.ts"]
    }
  }
}
